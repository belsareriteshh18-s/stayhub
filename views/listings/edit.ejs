
<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <!-- Main Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-dark text-white border-0 p-4">
                    <h2 class="fw-bold mb-1">Edit Listing</h2>
                    <p class="mb-0 text-white-50">
                        Update your property information
                    </p>
                </div>

                <!-- Form Body -->
                <div class="card-body p-4 p-md-5">

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=PUT"
                        class="row g-4 needs-validation"
                        novalidate
                        enctype="multipart/form-data"
                    >

                        <!-- Listing Title -->
                        <div class="col-12">

                            <label for="title" class="form-label fw-semibold">
                                Listing Title
                            </label>

                            <input
                                type="text"
                                class="form-control form-control-lg rounded-3"
                                id="title"
                                name="listing[title]"
                                value="<%= listing.title %>"
                                placeholder="Enter your listing title"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter a listing title.
                            </div>

                        </div>


                        <!-- Description -->
                        <div class="col-12">

                            <label for="description" class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea
                                class="form-control rounded-3"
                                id="description"
                                name="listing[description]"
                                rows="5"
                                placeholder="Describe your property"
                                required
                            ><%= listing.description %></textarea>

                            <div class="invalid-feedback">
                                Please enter a description.
                            </div>

                        </div>


                        <!-- Current Image -->
                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Current Image
                            </label>

                            <div class="mb-3">
                                <img
                                    src="<%= listing.image.url %>"
                                    alt="<%= listing.title %>"
                                    class="img-fluid rounded-3"
                                    style="max-height: 200px; width: 100%; object-fit: cover;"
                                >
                            </div>

                        </div>


                        <!-- New Image -->
                        <div class="col-12">

                            <label for="image" class="form-label fw-semibold">
                                Change Image
                            </label>

                            <div class="input-group input-group-lg">

                                <span class="input-group-text bg-light">
                                    🖼️
                                </span>

                                <input
                                    type="file"
                                    class="form-control"
                                    id="image"
                                    name="image"
                                    accept="image/jpeg,image/png,image/webp"
                                >

                            </div>

                            <div class="form-text">
                                Leave empty to keep the current image.
                                JPG, JPEG, PNG, or WEBP.
                            </div>

                        </div>


                        <!-- Price -->
                        <div class="col-12">

                            <label for="price" class="form-label fw-semibold">
                                Price per night
                            </label>

                            <div class="input-group input-group-lg">

                                <span class="input-group-text fw-bold">
                                    ₹
                                </span>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="price"
                                    name="listing[price]"
                                    value="<%= listing.price %>"
                                    placeholder="Enter price"
                                    min="0"
                                    required
                                >

                                <span class="input-group-text bg-light">
                                    / night
                                </span>

                            </div>

                            <div class="invalid-feedback">
                                Please enter a valid price.
                            </div>

                        </div>


                        <!-- Location -->
                        <div class="col-md-6">

                            <label for="location" class="form-label fw-semibold">
                                Location
                            </label>

                            <input
                                type="text"
                                class="form-control form-control-lg rounded-3"
                                id="location"
                                name="listing[location]"
                                value="<%= listing.location %>"
                                placeholder="e.g. Nagpur"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter the location.
                            </div>

                        </div>


                        <!-- Country -->
                        <div class="col-md-6">

                            <label for="country" class="form-label fw-semibold">
                                Country
                            </label>

                            <input
                                type="text"
                                class="form-control form-control-lg rounded-3"
                                id="country"
                                name="listing[country]"
                                value="<%= listing.country %>"
                                placeholder="e.g. India"
                                required
                            >

                            <div class="invalid-feedback">
                                Please enter the country.
                            </div>

                        </div>


                        <!-- Divider -->
                        <div class="col-12">
                            <hr class="my-2">
                        </div>


                        <!-- Buttons -->
                        <div class="col-12">

                            <div class="d-flex flex-column flex-sm-row gap-3">

                                <!-- Save -->
                                <button
                                    type="submit"
                                    class="btn btn-danger btn-lg px-4 rounded-3 fw-semibold"
                                >
                                    Save Changes
                                </button>


                                <!-- Cancel -->
                                <a
                                    href="/listings/<%= listing._id %>"
                                    class="btn btn-outline-secondary btn-lg px-4 rounded-3"
                                >
                                    Cancel
                                </a>


                                <!-- Create New -->
                                <a
                                    href="/listings/new"
                                    class="btn btn-dark btn-lg px-4 rounded-3"
                                >
                                    Create New
                                </a>

                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>
</div>

<script src="/js/scripts.js"></script>

