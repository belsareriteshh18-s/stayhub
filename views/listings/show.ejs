<% layout("/layouts/boilerplate") %>

<% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
    <script>
        const mapToken = <%- JSON.stringify(mapToken) %>;
        const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    </script>
<% } %>

<div class="container-fluid px-3 px-lg-4 py-4 stayhub-property">
    <div class="row g-4">

        <!-- LEFT: PROPERTY DETAILS -->
        <div class="col-lg-8">
            <div class="mb-3">
                <span class="badge bg-danger rounded-pill px-3 py-2 mb-2">StayHub</span>
                <h2 class="fw-bold mb-2"><%= listing.title %></h2>
                <p class="text-muted mb-0">
                    <i class="fa-solid fa-location-dot text-danger me-2"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>
            </div>

            <!-- PROPERTY IMAGE GALLERY -->
            <div class="property-gallery">
                <div class="main-property-image">
                    <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
                </div>
                <div class="side-property-images">
                    <div class="small-property-image">
                        <img src="<%= listing.image.url %>" alt="Property view">
                    </div>
                    <div class="small-property-image">
                        <img src="<%= listing.image.url %>" alt="Property interior">
                    </div>
                </div>
            </div>

            <!-- ABOUT PROPERTY -->
            <section class="property-about mt-4">
                <h4 class="fw-bold mb-2">About Property</h4>
                <p class="text-secondary lh-lg"><%= listing.description %></p>
                <p class="mb-3">
                    <strong>Hosted by:</strong>
                    <%= listing.owner ? listing.owner.username : "StayHub Host" %>
                </p>
            </section>

            <!-- AMENITIES (display examples; customize to your actual listing data) -->
            <section class="property-amenities mt-4">
                <h4 class="fw-bold mb-3">Amenities</h4>
                <div class="amenities-list">
                    <span><i class="fa-solid fa-wifi"></i> Free Wi-Fi</span>
                    <span><i class="fa-solid fa-snowflake"></i> Air Conditioning</span>
                    <span><i class="fa-solid fa-car"></i> Parking</span>
                    <span><i class="fa-solid fa-tv"></i> Television</span>
                </div>
            </section>

            <!-- EDIT / DELETE: ONLY THE LISTING OWNER -->
            <% if (currentuser && listing.owner && listing.owner._id && listing.owner._id.equals(currentuser._id)) { %>
                <div class="d-flex flex-wrap gap-2 mt-4">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-danger rounded-3">
                        <i class="fa-solid fa-pen-to-square me-2"></i>Edit Listing
                    </a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE"
                          onsubmit="return confirm('Are you sure you want to delete this listing?');">
                        <button type="submit" class="btn btn-outline-danger rounded-3">
                            <i class="fa-regular fa-trash-can me-2"></i>Delete Listing
                        </button>
                    </form>
                </div>
            <% } %>
        </div>

        <!-- RIGHT: PRICE / BOOKING / RATING -->
        <div class="col-lg-4">
            <aside class="booking-sidebar">
                <div class="booking-card">
                    <p class="text-muted mb-1">Price per night</p>
                    <h2 class="fw-bold mb-1">₹<%= listing.price.toLocaleString("en-IN") %></h2>
                    <p class="text-muted small mb-3">Taxes and fees may apply.</p>

                    <a href="/listings/<%= listing._id %>/book" class="btn btn-primary booking-button">
                        <i class="fa-solid fa-calendar-check me-2"></i>BOOK THIS NOW
                    </a>

                    <div class="booking-note mt-3">
                        <i class="fa-solid fa-shield-halved me-2"></i>
                        Find your next comfortable stay with StayHub.
                    </div>
                </div>

                <div class="booking-card rating-summary mt-3">
                    <div class="rating-summary-top">
                        <div class="rating-score">
                            <% if (listing.reviews && listing.reviews.length > 0) { %>
                                <%= (listing.reviews.reduce((sum, review) => sum + Number(review.rating || 0), 0) / listing.reviews.length).toFixed(1) %>
                            <% } else { %>
                                New
                            <% } %>
                        </div>
                        <div>
                            <strong><%= listing.reviews && listing.reviews.length ? "Guest Rating" : "No ratings yet" %></strong>
                            <p class="text-muted small mb-0">
                                <%= listing.reviews ? listing.reviews.length : 0 %> reviews
                            </p>
                        </div>
                    </div>

                    <hr>

                    <a href="#customer-reviews" class="reviews-link">
                        <i class="fa-solid fa-star text-warning me-2"></i>
                        Read Customer Reviews
                        <i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>

                    <div class="location-summary mt-3">
                        <i class="fa-solid fa-location-dot"></i>
                        <div>
                            <strong><%= listing.location %></strong>
                            <p class="text-muted small mb-0"><%= listing.country %></p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <!-- REVIEW FORM -->
    <% if (currentuser) { %>
        <div class="row mt-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3 p-md-4">
                        <h3 class="fw-bold mb-1">Submit Your Review</h3>
                        <p class="text-muted mb-4">Share your experience with other StayHub guests.</p>

                        <form action="/listings/<%= listing._id %>/reviews" method="POST"
                              novalidate class="needs-validation">
                            <div class="mb-4">
                                <label for="comment" class="form-label fw-semibold">Write Your Review</label>
                                <textarea name="review[comment]" id="comment" class="form-control rounded-3"
                                          placeholder="Tell us about your stay..." rows="4" required></textarea>
                                <div class="invalid-feedback">Please write a comment.</div>
                            </div>

                            <div class="rating-section mb-4">
                                <label class="rating-title">Give your rating</label>
                                <div class="rating">
                                    <input type="radio" id="star5" name="review[rating]" value="5" required>
                                    <label for="star5" title="5 stars"></label>
                                    <input type="radio" id="star4" name="review[rating]" value="4">
                                    <label for="star4" title="4 stars"></label>
                                    <input type="radio" id="star3" name="review[rating]" value="3">
                                    <label for="star3" title="3 stars"></label>
                                    <input type="radio" id="star2" name="review[rating]" value="2">
                                    <label for="star2" title="2 stars"></label>
                                    <input type="radio" id="star1" name="review[rating]" value="1">
                                    <label for="star1" title="1 star"></label>
                                </div>
                                <div class="rating-error">Please select a rating.</div>
                            </div>

                            <button type="submit" class="btn btn-dark rounded-3 px-4 fw-semibold">
                                <i class="fa-solid fa-paper-plane me-2"></i>Leave Feedback
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- CUSTOMER REVIEWS -->
    <div class="row mt-4" id="customer-reviews">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="fw-bold mb-2">Customer Reviews</h2>
                    <p class="text-muted mb-3">See what our guests have to say about their StayHub experience.</p>
                    <span class="badge bg-dark rounded-pill px-3 py-2">
                        <%= listing.reviews ? listing.reviews.length : 0 %> Reviews
                    </span>

                    <% if (!listing.reviews || listing.reviews.length === 0) { %>
                        <div class="text-center bg-light border rounded-4 p-4 mt-4">
                            <i class="fa-regular fa-comment-dots fs-2 text-muted mb-3"></i>
                            <h5 class="fw-bold">No reviews yet</h5>
                            <p class="text-muted mb-0">Be the first guest to share your experience.</p>
                        </div>
                    <% } else { %>
                        <div class="reviews-list mt-3">
                            <% for (let review of listing.reviews) { %>
                                <div class="border-bottom py-4">
                                    <div class="d-flex justify-content-between align-items-start gap-3">
                                        <div class="d-flex gap-3">
                                            <div class="review-avatar">
                                                <i class="fa-solid fa-user"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-1">
                                                    <%= review.author ? review.author.username : "StayHub Guest" %>
                                                </h6>
                                                <small class="text-muted">StayHub Guest</small>
                                            </div>
                                        </div>
                                        <div class="text-end text-nowrap">
                                            <div>
                                                <% for (let i = 1; i <= 5; i++) { %>
                                                    <% if (i <= review.rating) { %>
                                                        <i class="fa-solid fa-star text-warning"></i>
                                                    <% } else { %>
                                                        <i class="fa-regular fa-star text-warning"></i>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                            <small class="text-muted"><%= review.rating %>/5</small>
                                        </div>
                                    </div>

                                    <p class="text-secondary mt-3 mb-3 lh-lg">“<%= review.comment %>”</p>

                                    <% if (currentuser && review.author && review.author._id && review.author._id.equals(currentuser._id)) { %>
                                        <form method="POST"
                                              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this review?');">
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3 px-3">
                                                <i class="fa-regular fa-trash-can me-1"></i>Delete Review
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- MAP -->
    <div class="row mt-4">
        <div class="col-lg-8">
            <div class="text-center bg-light border rounded-4 p-4">
                <h3 class="fw-bold mb-3">Where you'll be</h3>
                <div id="map"></div>
            </div>
        </div>
    </div>
</div>

<script src="https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.js"></script>
<script src="/js/map.js"></script>
