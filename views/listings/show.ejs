<% layout("/layouts/boilerplate") %>

<!-- ================= MAP TOKEN ================= -->
<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
//    const coordinates =
</script>


<div class="container py-4 py-md-5">

    <div class="row justify-content-center">

        <!-- ================= MAIN CONTENT ================= -->
        <!-- Middle part only -->
        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <!-- ================= LISTING CARD ================= -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-dark text-white border-0 p-4">

                    <h2 class="fw-bold mb-1">
                        Property Details
                    </h2>

                    <p class="mb-0 text-white-50">
                        View complete information about this property
                    </p>

                </div>


                <!-- ================= IMAGE ================= -->
                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top"
                    alt="<%= listing.title %>"
                    style="height: 300px; object-fit: cover;"
                >


                <!-- ================= BODY ================= -->
                <div class="card-body p-4 p-md-5">

                    <!-- Title & Location -->
                    <div class="mb-4">

                        <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">
                            StayHub
                        </span>

                        <h1 class="fw-bold mb-2">
                            <%= listing.title %>
                        </h1>

                        <p class="text-muted mb-0">
                            <i class="fa-solid fa-location-dot me-2"></i>
                            <%= listing.location %>, <%= listing.country %>
                        </p>

                    </div>


                    <!-- ================= DESCRIPTION ================= -->
                    <div class="mb-4">

                        <h5 class="fw-bold mb-2">
                            About this place
                        </h5>

                        <i>
                            Owned by: <%= listing.owner.username %>
                        </i>

                        <p class="text-secondary lh-lg mb-0 mt-2">
                            <%= listing.description %>
                        </p>

                    </div>


                    <!-- ================= PRICE ================= -->
                    <div class="bg-light rounded-4 p-4 mb-4">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <small class="text-muted">
                                    Price per night
                                </small>

                                <h3 class="fw-bold mb-0">
                                    ₹<%= listing.price.toLocaleString("en-IN") %>
                                </h3>

                            </div>

                            <span class="badge bg-dark rounded-pill px-3 py-2">
                                / night
                            </span>

                        </div>

                    </div>


                    <!-- ================= LOCATION & COUNTRY ================= -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="border rounded-4 p-3 h-100">

                                <small class="text-muted">
                                    Location
                                </small>

                                <h6 class="fw-bold mt-2 mb-0">

                                    <i class="fa-solid fa-location-dot me-2"></i>

                                    <%= listing.location %>

                                </h6>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded-4 p-3 h-100">

                                <small class="text-muted">
                                    Country
                                </small>

                                <h6 class="fw-bold mt-2 mb-0">

                                    <i class="fa-solid fa-globe me-2"></i>

                                    <%= listing.country %>

                                </h6>

                            </div>

                        </div>

                    </div>


                    <hr class="my-4">


                    <!-- ================= BUTTON SECTION ================= -->
                     <div class="row g-3">

    <!-- Book Now -->
    <div class="col-sm-4">

        <a
            href="/listings/<%= listing._id %>/book"
            class="btn btn-success btn-lg rounded-3 w-100 fw-semibold"
        >
            <i class="fa-solid fa-calendar-check me-2"></i>
            Book Now
        </a>

    </div>
   


               <% if (currentuser && listing.owner._id.equals(currentuser._id)) { %>
                    <div class="row g-3">

                        <div class="col-sm-6">

                            <a
                                href="/listings/<%= listing._id %>/edit"
                                class="btn btn-danger btn-lg rounded-3 w-100 fw-semibold"
                            >

                                <i class="fa-solid fa-pen-to-square me-2"></i>

                                Edit Listing

                            </a>

                        </div>


                        <div class="col-sm-6">

                            <form
                                method="POST"
                                action="/listings/<%= listing._id %>?_method=DELETE"
                            >

                                <button
                                    type="submit"
                                    class="btn btn-outline-danger btn-lg rounded-3 w-100 fw-semibold"
                                >

                                    <i class="fa-regular fa-trash-can me-2"></i>

                                    Delete Listing

                                </button>
                 <%}%>
                            </form>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================= REVIEW FORM ================= -->

            <% if (currentuser) { %>

                <div class="card border-0 shadow-sm rounded-4 mt-4">

                    <div class="card-body p-4 p-md-5">

                        <!-- Review Heading -->

                        <div class="mb-4">

                            <h3 class="fw-bold mb-1">
                                Submit Your Review
                            </h3>

                            <p class="text-muted mb-0">
                                Share your experience with other StayHub guests.
                            </p>

                        </div>


                        <!-- Review Form -->

                        <form
                            action="/listings/<%= listing._id %>/reviews"
                            method="POST"
                            novalidate
                            class="needs-validation"
                        >

                            <!-- Comment -->

                            <div class="mb-4">

                                <label
                                    for="comment"
                                    class="form-label fw-semibold"
                                >
                                    Write Your Review
                                </label>

                                <textarea
                                    name="review[comment]"
                                    id="comment"
                                    class="form-control rounded-3"
                                    placeholder="Tell us about your stay..."
                                    rows="4"
                                    required
                                ></textarea>

                                <div class="invalid-feedback">
                                    Please write a comment.
                                </div>

                            </div>


                            <!-- Rating -->

                            <div class="rating-section">

                                <label class="rating-title">
                                    Give your rating
                                </label>

                                <div class="rating">

                                    <input
                                        type="radio"
                                        id="star5"
                                        name="review[rating]"
                                        value="5"
                                        required
                                    >

                                    <label
                                        for="star5"
                                        title="5 stars"
                                    ></label>


                                    <input
                                        type="radio"
                                        id="star4"
                                        name="review[rating]"
                                        value="4"
                                    >

                                    <label
                                        for="star4"
                                        title="4 stars"
                                    ></label>


                                    <input
                                        type="radio"
                                        id="star3"
                                        name="review[rating]"
                                        value="3"
                                    >

                                    <label
                                        for="star3"
                                        title="3 stars"
                                    ></label>


                                    <input
                                        type="radio"
                                        id="star2"
                                        name="review[rating]"
                                        value="2"
                                    >

                                    <label
                                        for="star2"
                                        title="2 stars"
                                    ></label>


                                    <input
                                        type="radio"
                                        id="star1"
                                        name="review[rating]"
                                        value="1"
                                    >

                                    <label
                                        for="star1"
                                        title="1 star"
                                    ></label>

                                </div>


                                <div class="rating-error">
                                    Please select a rating.
                                </div>

                            </div>


                            <!-- Submit -->

                            <button
                                type="submit"
                                class="btn btn-dark rounded-3 px-4 fw-semibold"
                            >

                                <i class="fa-solid fa-paper-plane me-2"></i>

                                Leave Feedback

                            </button>

                        </form>

                    </div>

                </div>

            <% } %>


            <!-- ================= ALL REVIEWS ================= -->

            <div class="card border-0 shadow-sm rounded-4 mt-4">

                <div class="card-body p-4 p-md-5">

                    <!-- Header -->

                    <div class="text-center mb-4">

                        <h2 class="fw-bold mb-2">
                            Customer Reviews
                        </h2>

                        <p class="text-muted mb-3">
                            See what our guests have to say about their StayHub experience.
                        </p>

                        <span class="badge bg-dark rounded-pill px-3 py-2">
                            <%= listing.reviews.length %> Reviews
                        </span>

                    </div>


                    <!-- ================= NO REVIEWS ================= -->

                    <% if (listing.reviews.length === 0) { %>

                        <div class="text-center bg-light border rounded-4 p-4">

                            <div
                                class="mx-auto mb-3 rounded-circle bg-white shadow-sm d-flex align-items-center justify-content-center"
                                style="width:65px; height:65px;"
                            >

                                <i class="fa-regular fa-comment-dots fs-3 text-muted"></i>

                            </div>

                            <h5 class="fw-bold">
                                No reviews yet
                            </h5>

                            <p class="text-muted mb-0">
                                Be the first guest to share your experience.
                            </p>

                        </div>


                    <% } else { %>


                        <!-- ================= REVIEWS LIST ================= -->

                        <div class="reviews-list">

                            <% for (let review of listing.reviews) { %>

                                <div class="border-bottom py-4">

                                    <div class="row g-3">

                                        <!-- User Icon -->

                                        <div class="col-auto">

                                            <div
                                                class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center shadow-sm"
                                                style="width:48px; height:48px;"
                                            >

                                                <i class="fa-solid fa-user"></i>

                                            </div>

                                        </div>


                                        <!-- Review Content -->

                                        <div class="col">

                                            <!-- Name + Rating -->

                                            <div class="d-flex justify-content-between align-items-start gap-3">

                                                <div>

                                                    <h6 class="fw-bold mb-1">
                                                        <%= review.author.username %>
                                                    </h6>

                                                    <small class="text-muted">
                                                        StayHub Guest
                                                    </small>

                                                </div>


                                                <!-- Stars -->

                                                <div class="text-end">

                                                    <div class="mb-1">

                                                        <% for (let i = 1; i <= 5; i++) { %>

                                                            <% if (i <= review.rating) { %>

                                                                <i class="fa-solid fa-star text-warning"></i>

                                                            <% } else { %>

                                                                <i class="fa-regular fa-star text-warning"></i>

                                                            <% } %>

                                                        <% } %>

                                                    </div>

                                                    <small class="text-muted">
                                                        <%= review.rating %>/5
                                                    </small>

                                                </div>

                                            </div>


                                            <!-- Comment -->

                                            <p class="text-secondary mt-3 mb-3 lh-lg">
                                                "<%= review.comment %>"
                                            </p>


                                            <!-- Delete Review -->

                                            <form
                                                method="POST"
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                class="d-inline"
                                            >

                                                <button
                                                    type="submit"
                                                    class="btn btn-outline-danger btn-sm rounded-3 px-3"
                                                    onclick="return confirm('Are you sure you want to delete this review?');"
                                                >

                                                    <i class="fa-regular fa-trash-can me-1"></i>

                                                    Delete Review

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            <% } %>

                        </div>


                    <% } %>

                </div>

            </div>


            <!-- ================= MAP ================= -->

            <div class="text-center bg-light border rounded-4 p-4 mt-4">

                <h3>
                    Where you'll be
                </h3>

                <div id="map"></div>

            </div>


        </div>

    </div>

</div>


<!-- ================= MAP SCRIPT ================= -->
<script src="/js/mapbox.js"></script>

