<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <!-- Main Card -->
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header bg-dark text-white border-0 p-4">
                    <h2 class="fw-bold mb-1">Add New Listing</h2>
                    <p class="mb-0 text-white-50">
                        Add information about your property
                    </p>
                </div>

                <!-- Form -->
                <div class="card-body p-4 p-md-5">

                    <form method="post" action="/listings" 
                    class="needs-validation"
                    novalidate 
                    enctype="multipart/form-data"
                    >

                        <!-- Title -->
                        <div class="mb-4">
                            <label for="title" class="form-label fw-semibold">
                                Listing Title
                            </label>

                            <input
                                id="title"
                                name="listing[title]"
                                placeholder="Enter listing title"
                                type="text"
                                class="form-control form-control-lg rounded-3"
                                required
                            >
                        </div>


                        <!-- Description -->
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea
                                id="description"
                                name="listing[description]"
                                placeholder="Describe your property"
                                class="form-control rounded-3"
                                rows="5"
                                required
                            ></textarea>
                        </div>

                         <!-- Image  -->
                       <!-- Image -->
<div class="mb-4">
    <label for="image" class="form-label fw-semibold">
        Upload Image
    </label>

    <div class="input-group input-group-lg">

        <span class="input-group-text bg-light">
            🖼️
        </span>

        <input
            id="image"
            name="image"
            type="file"
            class="form-control"
            accept="image/*"
            required
        >

    </div>

    <div class="form-text">
        Upload an image of your property.
    </div>
</div>
                        <!-- Price -->
                        <div class="mb-3">

                            <label for="price" class="form-label fw-semibold">
                                Price per night
                            </label>

                            <div class="input-group input-group-lg">

                                <span class="input-group-text fw-bold">
                                    ₹
                                </span>

                                <input
                                    id="price"
                                    name="listing[price]"
                                    placeholder="Enter price"
                                    type="number"
                                    class="form-control"
                                    min="0"
                                    required
                                >

                                <span class="input-group-text bg-light">
                                    / night
                                </span>

                            </div>

                        </div>

                        

                        <!-- Location + Country -->
                        <div class="row">

                            <!-- Location -->
                            <div class="col-md-6 mb-4">

                                <label for="location" class="form-label fw-semibold">
                                    Location
                                </label>

                                <input
                                    id="location"
                                    name="listing[location]"
                                    placeholder="e.g. Nagpur"
                                    type="text"
                                    class="form-control form-control-lg rounded-3"
                                    required
                                >

                            </div>


                            <!-- Country -->
                            <div class="col-md-6 mb-4">

                                <label for="country" class="form-label fw-semibold">
                                    Country
                                </label>

                                <input
                                    id="country"
                                    name="listing[country]"
                                    placeholder="e.g. India"
                                    type="text"
                                    class="form-control form-control-lg rounded-3"
                                    required
                                >

                            </div>

                        </div>


                        <!-- Divider -->
                        <hr class="my-4">


                        <!-- Buttons -->
                        <div class="d-flex flex-column flex-sm-row gap-3">

                            <button
                                type="submit"
                                class="btn btn-dark btn-lg px-4 rounded-3 fw-semibold"
                            >
                                Add Listing
                            </button>

                            <a
                                href="/listings"
                                class="btn btn-outline-secondary btn-lg px-4 rounded-3"
                            >
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
