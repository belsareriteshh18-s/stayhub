<!DOCTYPE html>
<html lang="en">
<head>


    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>StayHub | Find Your Perfect Stay</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #fff;
            color: #222;
        }

        .navbar {
            padding: 18px 7%;
            background: white;
            border-bottom: 1px solid #eee;
        }

        .brand {
            font-size: 28px;
            font-weight: bold;
            color: #fe424d;
            text-decoration: none;
        }

        .nav-link {
            color: #333;
            font-weight: 500;
        }

        .hero {
            min-height: 520px;
            padding: 90px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            background:
                linear-gradient(
                    rgba(0, 0, 0, 0.42),
                    rgba(0, 0, 0, 0.42)
                ),
                url("https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=1800&q=85")
                center/cover no-repeat;
            color: white;
        }

        .hero h1 {
            font-size: clamp(38px, 6vw, 65px);
            font-weight: 800;
            margin-bottom: 20px;
        }

        .hero p {
            font-size: 19px;
            margin-bottom: 30px;
        }

        .search-box {
            display: flex;
            max-width: 620px;
            margin: auto;
            background: white;
            padding: 8px;
            border-radius: 50px;
            gap: 8px;
        }

        .search-box input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            padding: 12px 18px;
            border-radius: 30px;
        }

        .search-btn {
            border: none;
            background: #fe424d;
            color: white;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: bold;
        }

        .search-btn:hover,
        .explore-btn:hover {
            background: #e52e3a;
            color: white;
        }

        .features {
            padding: 65px 7%;
            text-align: center;
        }

        .features h2 {
            font-weight: 750;
            margin-bottom: 12px;
        }

        .feature-card {
            height: 100%;
            padding: 30px 20px;
            border: 1px solid #eee;
            border-radius: 18px;
            transition: 0.25s;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px #00000010;
        }

        .feature-card i {
            font-size: 32px;
            color: #fe424d;
            margin-bottom: 18px;
        }

        .explore-btn {
            display: inline-block;
            background: #fe424d;
            color: white;
            text-decoration: none;
            padding: 14px 28px;
            border-radius: 30px;
            font-weight: bold;
            margin-top: 20px;
        }

        footer {
            background: #fafafa;
            border-top: 1px solid #eee;
            text-align: center;
            padding: 25px;
            color: #666;
        }
        .f-info{
            margin-bottom: 10px;
        }

        @media (max-width: 576px) {
            .navbar {
                padding: 15px 5%;
            }

            .hero {
                min-height: 470px;
                padding: 60px 18px;
            }

            .search-box {
                border-radius: 18px;
                flex-direction: column;
                padding: 12px;
            }

            .search-box input,
            .search-btn {
                width: 100%;
            }
        }
    </style>
</head>

<body>


     
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid p-0">

              <a href="/listings" class="navbar-brand d-flex align-items-center gap-2">
        <!-- Brand -->
            <img src="/stayhub.png"
             alt="stayhub logo"
             width="60"
             height="60"
             class="d-inline-block align-text-top">
       </a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarMenu"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div
                class="collapse navbar-collapse"
                id="navbarMenu"
            >
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/listings">Explore Stays</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/listings/new">Add Listing</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/signup">Sign Up</a>
                    </li>

                </ul>
            </div>

        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">

            <h1>Find Your Perfect Stay</h1>

            <p>
                Discover beautiful homes, hotels and unique places
                for your next adventure.
            </p>

            <form action="/listings/search" method="GET" class="search-box">

                <input
                    type="text"
                    name="location"
                    placeholder="Where do you want to stay?"
                    aria-label="Search location"
                    required
                >

                <button class="search-btn" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search
                </button>

            </form>

            <a href="/listings" class="explore-btn">
                Explore All Stays
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>
        
    </section>

 <footer>
    <div class="f-info">

        <div class="f-info-socials">
            <i class="fa-brands fa-facebook"></i>
            <i class="fa-brands fa-instagram"></i>
           
        </div>

        <div class="f-info-brand">
            © 2026 StayHub Private Limited
        </div>

        <div class="f-info-links">
            <a href="/privacy">Privacy</a>
            <a href="/terms">Terms</a>
            <a href="/contact">Contact</a>
        </div>

    </div>
</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>