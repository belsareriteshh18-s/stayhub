
<% layout("/layouts/boilerplate") %>

<div class="container py-5">

    <!-- Hero Section -->
    <div class="row align-items-center g-5 mb-5">

        <div class="col-lg-6">

            <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">
                About StayHub
            </span>

            <h1 class="display-5 fw-bold mb-3">
                Find a place that feels like home.
            </h1>

            <p class="lead text-muted">
                StayHub makes it simple to discover comfortable,
                affordable, and memorable places to stay wherever
                your journey takes you.
            </p>

            <a href="/listings"
               class="btn btn-danger btn-lg rounded-3 px-4 fw-semibold">
                Explore Listings
            </a>

        </div>

        <div class="col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <img
                    src="https://images.unsplash.com/photo-1564013799919-ab600027ffc6"
                    class="img-fluid"
                    alt="Beautiful Stay"
                    style="height: 350px; width: 100%; object-fit: cover;"
                >

            </div>

        </div>

    </div>


    <!-- About StayHub -->
    <div class="row justify-content-center mb-5">

        <div class="col-lg-9 text-center">

            <h2 class="fw-bold mb-3">
                What is StayHub?
            </h2>

            <p class="text-muted lh-lg">
                StayHub is a modern property listing platform designed
                to connect travelers with great places to stay.
                Whether you are planning a weekend trip, a family
                vacation, or a longer stay, StayHub helps you explore
                different properties and find the right place for your needs.
            </p>

        </div>

    </div>


    <!-- Features -->
    <div class="row g-4 mb-5">

        <div class="col-md-4">

            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">

                <div class="fs-1 mb-3">
                    
                </div>

                <h5 class="fw-bold">
                    Comfortable Stays
                </h5>

                <p class="text-muted mb-0">
                    Discover properties designed to make your stay
                    comfortable and enjoyable.
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">

                <div class="fs-1 mb-3">
                    
                </div>

                <h5 class="fw-bold">
                    Easy Discovery
                </h5>

                <p class="text-muted mb-0">
                    Browse listings and quickly find properties
                    that match your travel requirements.
                </p>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 text-center">

                <div class="fs-1 mb-3">
                    
                </div>

                <h5 class="fw-bold">
                    Memorable Experiences
                </h5>

                <p class="text-muted mb-0">
                    We want every stay to become a comfortable
                    and memorable part of your journey.
                </p>

            </div>

        </div>

    </div>


    <!-- Mission Section -->
    <div class="card bg-dark text-white border-0 rounded-4 shadow-lg mb-5">

        <div class="card-body p-4 p-md-5 text-center">

            <h2 class="fw-bold mb-3">
                Our Mission
            </h2>

            <p class="lead text-white-50 mb-0">
                Our mission is to make finding a place to stay
                simple, convenient, and enjoyable for everyone.
                StayHub aims to create a platform where travelers
                can explore properties and make better stay decisions.
            </p>

        </div>

    </div>


    <!-- Call To Action -->
    <div class="text-center py-4">

        <h2 class="fw-bold mb-3">
            Ready to find your next stay?
        </h2>

        <p class="text-muted mb-4">
            Explore our listings and discover a place for your next journey.
        </p>

        <a href="/listings"
           class="btn btn-danger btn-lg rounded-3 px-5 fw-semibold">
            Explore StayHub
        </a>

    </div>

</div>
